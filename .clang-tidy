Checks: >
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  bugprone-empty-catch,
  cppcoreguidelines-pro-type-cstyle-cast,
  google-build-using-namespace,
  misc-include-cleaner,
  modernize-make-unique,
  modernize-use-equals-default,
  modernize-use-nullptr,
  modernize-use-override,
  readability-else-after-return,
  readability-function-size,
  readability-identifier-naming,
  readability-magic-numbers
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include|src|tests)/.*'
FormatStyle: file
CheckOptions:
  readability-function-size.LineThreshold: 30
  readability-function-size.NestingThreshold: 3
  readability-function-size.ParameterThreshold: 4
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.NamespaceSuffix: Ns
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassSuffix: Class
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.MemberCase: camelBack
  readability-identifier-naming.ConstantCase: UPPER_CASE
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.LocalConstantPointerCase: camelBack
  readability-identifier-naming.ConstexprVariableCase: UPPER_CASE
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-magic-numbers.IgnoredIntegerValues: '0;1;2;3;4;'
  readability-magic-numbers.IgnoredFloatingPointValues: '0.0;1.0;100.0;'
